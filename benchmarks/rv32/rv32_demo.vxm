comb rs2_hit5_or_or or rs2_hit5_or rs2_hit7_or
wire rs2_hit9_or_or u1
comb rs2_hit9_or_or or rs2_hit9_or rs2_hit11_or
wire rs2_hit13_or_or u1
comb rs2_hit13_or_or or rs2_hit13_or rs2_hit15_or
wire rs2_hit17_or_or u1
comb rs2_hit17_or_or or rs2_hit17_or rs2_hit19_or
wire rs2_hit21_or_or u1
comb rs2_hit21_or_or or rs2_hit21_or rs2_hit23_or
wire rs2_hit25_or_or u1
comb rs2_hit25_or_or or rs2_hit25_or rs2_hit27_or
wire rs2_hit29_or_or u1
comb rs2_hit29_or_or or rs2_hit29_or rs2_hit31
wire rs2_hit1_or_or_or u1
comb rs2_hit1_or_or_or or rs2_hit1_or_or rs2_hit5_or_or
wire rs2_hit9_or_or_or u1
comb rs2_hit9_or_or_or or rs2_hit9_or_or rs2_hit13_or_or
wire rs2_hit17_or_or_or u1
comb rs2_hit17_or_or_or or rs2_hit17_or_or rs2_hit21_or_or
wire rs2_hit25_or_or_or u1
comb rs2_hit25_or_or_or or rs2_hit25_or_or rs2_hit29_or_or
wire rs2_hit1_or_or_or_or u1
comb rs2_hit1_or_or_or_or or rs2_hit1_or_or_or rs2_hit9_or_or_or
wire rs2_hit17_or_or_or_or u1
comb rs2_hit17_or_or_or_or or rs2_hit17_or_or_or rs2_hit25_or_or_or
wire rs2_hit1_or_or_or_or_or u1
comb rs2_hit1_or_or_or_or_or or rs2_hit1_or_or_or_or rs2_hit17_or_or_or_or
wire rs2_valid u1
comb rs2_valid copy rs2_hit1_or_or_or_or_or
wire a u32
comb a mux rs1_valid raw_a zero32
wire b u32
comb b mux rs2_valid raw_b zero32

# Decode, sign extension, arithmetic, and bus controls.
wire funct_zero u1
comb funct_zero eq funct zero3
wire funct_word u1
comb funct_word eq funct word_funct
wire add_f7 u1
comb add_f7 eq funct7 add_funct
wire sub_f7 u1
comb sub_f7 eq funct7 sub_funct
wire add_sub_f7 u1
comb add_sub_f7 or add_f7 sub_f7
wire reg_funct u1
comb reg_funct and funct_zero add_sub_f7
wire reg_ok u1
comb reg_ok and dec_regop reg_funct
wire addi_ok u1
comb addi_ok and dec_addi funct_zero
wire beq_kind u1
comb beq_kind and dec_beq funct_zero
wire upper_sign u20
comb upper_sign mux sign sign20mask zero20
wire imm_s u12
comb imm_s concat imm_hi rd
wire imm_data u12
comb imm_data mux dec_sw imm_s imm_i
wire imm_data32 u32
comb imm_data32 concat upper_sign imm_data
wire addr u32
comb addr add a imm_data32
wire addr_low u2
comb addr_low slice addr 1 0
wire addr_aligned u1
comb addr_aligned eq addr_low zero2
wire mem_kind u1
comb mem_kind or dec_lw dec_sw
wire mem_shape_ok u1
comb mem_shape_ok and funct_word addr_aligned
wire mem_ok u1
comb mem_ok and mem_kind mem_shape_ok
wire mem_load u1
comb mem_load and dec_lw mem_shape_ok
wire mem_store u1
comb mem_store and dec_sw mem_shape_ok
wire not_reset u1
comb not_reset xor rst one
wire branch_tail u5
comb branch_tail concat branch_low zero1
wire branch_body u11
comb branch_body concat branch_mid branch_tail
wire branch_imm u12
comb branch_imm concat branch_11 branch_body
wire branch_offset u32
comb branch_offset concat upper_sign branch_imm
wire next_seq u32
comb next_seq add pc four
wire branch_dest u32
comb branch_dest add pc branch_offset
wire equal_ab u1
comb equal_ab eq a b
wire branch_taken u1
comb branch_taken and beq_kind equal_ab
wire candidate_pc u32
comb candidate_pc mux branch_taken branch_dest next_seq
wire pc_low u2
comb pc_low slice candidate_pc 1 0
wire pc_aligned u1
comb pc_aligned eq pc_low zero2
wire beq_ok u1
comb beq_ok and beq_kind pc_aligned
wire legal_alu u1
comb legal_alu or reg_ok addi_ok
wire legal_calc u1
comb legal_calc or legal_alu dec_lui
wire legal_flow u1
comb legal_flow or beq_ok mem_ok
wire legal u1
comb legal or legal_calc legal_flow
wire next_pc u32
comb next_pc mux legal candidate_pc pc
wire reg_add u32
comb reg_add add a b
wire reg_sub u32
comb reg_sub sub a b
wire reg_value u32
comb reg_value mux sub_f7 reg_sub reg_add
wire lui_value u32
comb lui_value concat imm_u zero12
wire alu_value u32
comb alu_value mux dec_regop reg_value addr
wire alu_or_u u32
comb alu_or_u mux dec_lui lui_value alu_value
wire result u32
comb result mux dec_lw mem_rdata alu_or_u
wire has_result u1
comb has_result or legal_calc mem_load
wire rd_nonzero u1
comb rd_nonzero ne rd zero5
wire write_rd u1
comb write_rd and has_result rd_nonzero
wire write_enable u1
comb write_enable and write_rd not_reset
comb illegal xor legal one
comb mem_addr mux mem_kind addr zero32
comb mem_wdata copy b
comb mem_read and mem_load not_reset
comb mem_write and mem_store not_reset
sync pc clk rst next_pc
write registers clk write_enable rd result
end
