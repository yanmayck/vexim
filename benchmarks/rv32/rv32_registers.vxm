# Complete implementation of the rv32_demo seven-instruction profile.
module rv32_demo
input clk u1
input rst u1
input instr u32
input mem_rdata u32
output pc u32
output mem_addr u32
output mem_wdata u32
output mem_write u1
output mem_read u1
output illegal u1
wire one u1
comb one const 1
wire zero2 u2
comb zero2 const 0
wire zero3 u3
comb zero3 const 0
wire zero5 u5
comb zero5 const 0
wire zero12 u12
comb zero12 const 0
wire zero32 u32
comb zero32 const 0
wire four u32
comb four const 4
wire word_funct u3
comb word_funct const 2
wire add_funct u7
comb add_funct const 0
wire sub_funct u7
comb sub_funct const 32
wire sign20mask u20
comb sign20mask const 1048575
wire zero20 u20
comb zero20 const 0
wire zero1 u1
comb zero1 const 0
wire opcode u7
comb opcode slice instr 6 0
wire rd u5
comb rd slice instr 11 7
wire funct u3
comb funct slice instr 14 12
wire rs1 u5
comb rs1 slice instr 19 15
wire rs2 u5
comb rs2 slice instr 24 20
wire funct7 u7
comb funct7 slice instr 31 25
wire sign u1
comb sign slice instr 31 31
wire imm_i u12
comb imm_i slice instr 31 20
wire imm_hi u7
comb imm_hi slice instr 31 25
wire imm_u u20
comb imm_u slice instr 31 12
wire branch_11 u1
comb branch_11 slice instr 7 7
wire branch_mid u6
comb branch_mid slice instr 30 25
wire branch_low u4
comb branch_low slice instr 11 8
wire op_lui u7
comb op_lui const 55
wire dec_lui u1
comb dec_lui eq opcode op_lui
wire op_addi u7
comb op_addi const 19
wire dec_addi u1
comb dec_addi eq opcode op_addi
wire op_regop u7
comb op_regop const 51
wire dec_regop u1
comb dec_regop eq opcode op_regop
wire op_beq u7
comb op_beq const 99
wire dec_beq u1
comb dec_beq eq opcode op_beq
wire op_lw u7
comb op_lw const 3
wire dec_lw u1
comb dec_lw eq opcode op_lw
wire op_sw u7
comb op_sw const 35
wire dec_sw u1
comb dec_sw eq opcode op_sw

# Register file: resettable registers, two balanced read trees, and hardwired x0.
wire idx1 u5
comb idx1 const 1
wire sel1 u1
comb sel1 eq rd idx1
wire we1 u1
comb we1 and write_rd sel1
wire x1 u32
wire nx1 u32
comb nx1 mux we1 result x1
sync x1 clk rst nx1
