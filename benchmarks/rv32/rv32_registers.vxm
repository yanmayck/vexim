wire a_bit0 u1
comb a_bit0 slice rs1 0 0
wire a_0_0 u32
comb a_0_0 mux a_bit0 x1 zero32
wire a_0_1 u32
comb a_0_1 mux a_bit0 x3 x2
wire a_0_2 u32
comb a_0_2 mux a_bit0 x5 x4
wire a_0_3 u32
comb a_0_3 mux a_bit0 x7 x6
wire a_0_4 u32
comb a_0_4 mux a_bit0 x9 x8
wire a_0_5 u32
comb a_0_5 mux a_bit0 x11 x10
wire a_0_6 u32
comb a_0_6 mux a_bit0 x13 x12
wire a_0_7 u32
comb a_0_7 mux a_bit0 x15 x14
wire a_0_8 u32
comb a_0_8 mux a_bit0 x17 x16
wire a_0_9 u32
comb a_0_9 mux a_bit0 x19 x18
wire a_0_10 u32
comb a_0_10 mux a_bit0 x21 x20
wire a_0_11 u32
comb a_0_11 mux a_bit0 x23 x22
wire a_0_12 u32
comb a_0_12 mux a_bit0 x25 x24
wire a_0_13 u32
comb a_0_13 mux a_bit0 x27 x26
wire a_0_14 u32
comb a_0_14 mux a_bit0 x29 x28
wire a_0_15 u32
comb a_0_15 mux a_bit0 x31 x30
wire a_bit1 u1
comb a_bit1 slice rs1 1 1
wire a_1_0 u32
comb a_1_0 mux a_bit1 a_0_1 a_0_0
wire a_1_1 u32
comb a_1_1 mux a_bit1 a_0_3 a_0_2
wire a_1_2 u32
comb a_1_2 mux a_bit1 a_0_5 a_0_4
wire a_1_3 u32
comb a_1_3 mux a_bit1 a_0_7 a_0_6
wire a_1_4 u32
comb a_1_4 mux a_bit1 a_0_9 a_0_8
wire a_1_5 u32
comb a_1_5 mux a_bit1 a_0_11 a_0_10
wire a_1_6 u32
comb a_1_6 mux a_bit1 a_0_13 a_0_12
wire a_1_7 u32
comb a_1_7 mux a_bit1 a_0_15 a_0_14
wire a_bit2 u1
comb a_bit2 slice rs1 2 2
wire a_2_0 u32
comb a_2_0 mux a_bit2 a_1_1 a_1_0
wire a_2_1 u32
comb a_2_1 mux a_bit2 a_1_3 a_1_2
wire a_2_2 u32
comb a_2_2 mux a_bit2 a_1_5 a_1_4
wire a_2_3 u32
comb a_2_3 mux a_bit2 a_1_7 a_1_6
wire a_bit3 u1
comb a_bit3 slice rs1 3 3
wire a_3_0 u32
comb a_3_0 mux a_bit3 a_2_1 a_2_0
wire a_3_1 u32
comb a_3_1 mux a_bit3 a_2_3 a_2_2
wire a_bit4 u1
comb a_bit4 slice rs1 4 4
wire a u32
comb a mux a_bit4 a_3_1 a_3_0
wire b_bit0 u1
comb b_bit0 slice rs2 0 0
wire b_0_0 u32
comb b_0_0 mux b_bit0 x1 zero32
wire b_0_1 u32
comb b_0_1 mux b_bit0 x3 x2
wire b_0_2 u32
comb b_0_2 mux b_bit0 x5 x4
wire b_0_3 u32
comb b_0_3 mux b_bit0 x7 x6
wire b_0_4 u32
comb b_0_4 mux b_bit0 x9 x8
wire b_0_5 u32
comb b_0_5 mux b_bit0 x11 x10
wire b_0_6 u32
comb b_0_6 mux b_bit0 x13 x12
wire b_0_7 u32
comb b_0_7 mux b_bit0 x15 x14
wire b_0_8 u32
comb b_0_8 mux b_bit0 x17 x16
wire b_0_9 u32
comb b_0_9 mux b_bit0 x19 x18
wire b_0_10 u32
comb b_0_10 mux b_bit0 x21 x20
wire b_0_11 u32
comb b_0_11 mux b_bit0 x23 x22
wire b_0_12 u32
comb b_0_12 mux b_bit0 x25 x24
wire b_0_13 u32
comb b_0_13 mux b_bit0 x27 x26
wire b_0_14 u32
comb b_0_14 mux b_bit0 x29 x28
wire b_0_15 u32
comb b_0_15 mux b_bit0 x31 x30
wire b_bit1 u1
comb b_bit1 slice rs2 1 1
wire b_1_0 u32
comb b_1_0 mux b_bit1 b_0_1 b_0_0
wire b_1_1 u32
comb b_1_1 mux b_bit1 b_0_3 b_0_2
wire b_1_2 u32
comb b_1_2 mux b_bit1 b_0_5 b_0_4
wire b_1_3 u32
comb b_1_3 mux b_bit1 b_0_7 b_0_6
wire b_1_4 u32
comb b_1_4 mux b_bit1 b_0_9 b_0_8
wire b_1_5 u32
comb b_1_5 mux b_bit1 b_0_11 b_0_10
wire b_1_6 u32
comb b_1_6 mux b_bit1 b_0_13 b_0_12
wire b_1_7 u32
comb b_1_7 mux b_bit1 b_0_15 b_0_14
wire b_bit2 u1
comb b_bit2 slice rs2 2 2
wire b_2_0 u32
comb b_2_0 mux b_bit2 b_1_1 b_1_0
wire b_2_1 u32
comb b_2_1 mux b_bit2 b_1_3 b_1_2
wire b_2_2 u32
comb b_2_2 mux b_bit2 b_1_5 b_1_4
